# RailScout Backend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# RailRadar API key — obtained from https://api.railradar.in
# This key is read ONLY by the backend and is never sent to the extension client.
RAILRADAR_API_KEY=your_railradar_api_key_here

# Port the Express server listens on (defaults to 3000 if omitted)
PORT=3000
